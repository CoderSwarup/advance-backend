# Environment: development | production
NODE_ENV=development

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

PORT=3000
APP_NAME=advance-backend

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Level: debug | info | warn | error
LOGGING_LEVEL=debug

# Format: console (pretty, dev) | json (structured, production)
LOGGING_FORMAT=console

# Directory for log files (relative to project root)
LOGGING_DIRECTORY=logs

# Requests slower than this (in milliseconds) are logged as slow
LOGGING_SLOW_REQUEST_THRESHOLD_MS=200

# Log files are rotated daily and kept for this many days
LOGGING_RETENTION_DAYS=7
