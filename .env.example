# Environment: development | production
NODE_ENV=development

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

PORT=8000
APP_NAME=advance-backend

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Level: debug | info | warn | error
LOGGING_LEVEL=debug

# Format: console (pretty, dev) | json (structured, production)
LOGGING_FORMAT=console

# Directory for log files (relative to project root)
LOGGING_DIRECTORY=logs

# Requests slower than this (in milliseconds) are logged as slow
LOGGING_SLOW_REQUEST_THRESHOLD_MS=200

# Log files are rotated daily and kept for this many days
LOGGING_RETENTION_DAYS=7

# ============================================================================
# LOGGING OBSERVABILITY / GRAFANA LOKI
# ============================================================================

# Ship logs to Loki (requires docker:up → pnpm docker:up)
LOKI_ENABLED=false

# Loki push endpoint
LOKI_URL=http://localhost:3100

# ============================================================================
# MONITORING / PROMETHEUS
# ============================================================================

# Expose /metrics endpoint + collect Prometheus metrics (Prometheus scrapes
# this app via docker/prometheus/prometheus.yml)
MONITORING_ENABLED=true
