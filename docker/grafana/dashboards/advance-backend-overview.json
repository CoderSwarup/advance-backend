        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "max(up{job=\"advance-backend\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Service Up",
      "type": "stat"
