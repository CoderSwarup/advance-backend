    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Prometheus scrape target health: 1 = UP, 0 = DOWN.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 0, "text": "DOWN" },
                "1": { "color": "green", "index": 1, "text": "UP" }
